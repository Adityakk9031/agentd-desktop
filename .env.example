# ─────────────────────────────────────────────────────────────
# AI Operations Assistant — Environment Configuration Template
# ─────────────────────────────────────────────────────────────
# Copy this file to .env and fill in your real keys:
#   cp .env.example .env
# NEVER commit your .env file to version control!
# ─────────────────────────────────────────────────────────────

# ── Models (bring your own) ───────────────────────────────────
# Write models as provider:model. Prefer agentd.yaml (run `agentd init`);
# these variables override it. Check your setup with `agentd doctor`.
#AGENTD_MODEL_DEFAULT=openai:gpt-5.4-mini
#AGENTD_MODEL_DEFAULT_FALLBACKS=google_genai:gemini-3.5-flash,ollama:llama3.1
#AGENTD_MODEL_PLANNER=anthropic:claude-sonnet-5-5
#AGENTD_MODEL_EMBEDDINGS=openai:text-embedding-3-small

# Provider keys: set only the ones you use.
#OPENAI_API_KEY=
#ANTHROPIC_API_KEY=
#GOOGLE_API_KEY=
#OPENROUTER_API_KEY=
#XAI_API_KEY=
#GROQ_API_KEY=

# Legacy: if only GEMINI_API_KEY is set, Gemini is the default model and
# gemini-embedding-001 (768 dimensions) is used for memory.
#GEMINI_API_KEY=your_gemini_api_key_here
#GEMINI_MODEL=gemini-3.5-flash

# ── GitHub (Highly Recommended) ───────────────────────────────
# Get a token at: https://github.com/settings/tokens
# Use "Generate new token (classic)" → select public_repo scope
# Without token: 60 requests/hour. With token: 5,000 requests/hour.
GITHUB_TOKEN=your_github_token_here

# ── OpenWeatherMap (Required for Weather tasks) ────────────────
# Sign up free at: https://home.openweathermap.org/users/sign_up
# Then get your key at: https://home.openweathermap.org/api_keys
OPENWEATHER_KEY=your_openweathermap_key_here

# ── NewsAPI (Required for News tasks) ─────────────────────────
# Register free at: https://newsapi.org/register
NEWSAPI_KEY=your_newsapi_key_here

# ── Tool Permissions (enforced in code, before every tool call) ──
# Comma-separated tool-name globs. Precedence: deny > ask > allow > default.
# "ask" steps are held and the run goes to human review.
#PERMISSION_DEFAULT=allow
#PERMISSION_ALLOW=github_*,weather_*,news_*
# Default ask list covers delete/remove/drop/post/send/publish/pay/purchase/order
#PERMISSION_ASK=*delete*,*remove*,*drop*,*post*,*send*,*publish*,*pay*,*purchase*,*order*
#PERMISSION_DENY=

# ── Chat Channels (Optional — one agent brain, many doors) ────
# Telegram: token from @BotFather. Long-polling, no public URL needed.
#TELEGRAM_BOT_TOKEN=123456:ABC-your-botfather-token
# Comma-separated chat ids allowed to talk to the bot (recommended!)
#TELEGRAM_ALLOWED_CHAT_IDS=

# Discord: bot token from the Discord Developer Portal (enable the
# MESSAGE CONTENT privileged intent). Gateway = outbound, no public URL.
#DISCORD_BOT_TOKEN=your-discord-bot-token
# Optional comma-separated channel ids the bot answers in
#DISCORD_ALLOWED_CHANNEL_IDS=

# Slack: enable Socket Mode + message events in the app config.
# SLACK_APP_TOKEN starts with xapp-, SLACK_BOT_TOKEN with xoxb-
#SLACK_APP_TOKEN=xapp-your-app-token
#SLACK_BOT_TOKEN=xoxb-your-bot-token
# Optional comma-separated channel ids the bot answers in
#SLACK_ALLOWED_CHANNELS=

# ── Server Configuration ──────────────────────────────────────
PORT=8000
